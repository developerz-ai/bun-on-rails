# Application
APP_NAME=DemoApp
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demo_development

# Redis
REDIS_URL=redis://localhost:6379

# Session
SECRET_KEY_BASE=your-secret-key-here-change-in-production

# Mailer (development uses Mailhog)
MAILER_ADAPTER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Storage (development uses local filesystem)
STORAGE_ADAPTER=local

# AWS (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# SendGrid (production)
# SENDGRID_API_KEY=

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
