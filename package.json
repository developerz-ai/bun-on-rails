{
  "name": "bun-on-rails",
  "version": "0.1.0",
  "description": "A full-stack JavaScript framework built on Bun with Rails-like conventions",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "brails": "./src/cli/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.js dev",
    "start": "bun run src/cli/index.js start",
    "build": "bun run src/cli/build.js",
    "test": "bun test test/",
    "test:unit": "bun test --filter unit",
    "test:integration": "bun test --filter integration",
    "lint": "bunx eslint --max-warnings=0 src/",
    "format": "bunx prettier --write .",
    "docs:dev": "bunx vitepress dev docs",
    "docs:build": "bunx vitepress build docs",
    "docs:preview": "bunx vitepress preview docs"
  },
  "keywords": [
    "bun",
    "rails",
    "framework",
    "full-stack",
    "javascript",
    "mvc",
    "orm",
    "websockets",
    "jobs"
  ],
  "author": "BunOnRails Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/bun-on-rails.git"
  },
  "bugs": {
    "url": "https://github.com/developerz-ai/bun-on-rails/issues"
  },
  "homepage": "https://developerz-ai.github.io/bun-on-rails/",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@react-email/render": "^2.1.1",
    "@sentry/bun": "^8.51.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitepress": "^2.0.0-alpha.21",
    "prettier": "^3.9.10",
    "eslint": "^8.0.0",
    "espree": "^9.6.1"
  },
  "overrides": {
    "brace-expansion": "^1.1.21"
  }
}
