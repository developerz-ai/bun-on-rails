#!/usr/bin/env bash
# pre-commit gate — established by dz-runner setup mode. Runs `bin/check`,
# which runs the same gate commands CI runs as separate steps
# (.github/workflows/ci.yml), so a commit that would fail CI fails here first.
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/check
