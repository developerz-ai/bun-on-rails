# .env.example — established by dz-runner setup mode.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# dormant: read by demo/config/database.js; the framework gate (bun lint && bun test && bun run build) never needs a datab (optional)
DATABASE_URL=

# dormant: read by demo/config/environments/production.js; BullMQ jobs are optional and the framework gate does not need R (optional)
REDIS_URL=

# dormant: read by src/controller/middleware.js — falls back to 'change-me-in-production', so setup/dev/check all succeed  (optional)
SESSION_SECRET=

# dormant: read by demo/config/environments/production.js only; the demo app is not part of the gate. (optional)
SECRET_KEY_BASE=

# dormant: documented in demo/.env.example, not read by any gate command. (optional)
APP_NAME=

# dormant: read by demo/config/environments/production.js only. (optional)
MAILER_ADAPTER=

# dormant: documented in demo/.env.example, not read by any gate command. (optional)
SMTP_HOST=

# dormant: documented in demo/.env.example, not read by any gate command. (optional)
SMTP_PORT=

# dormant: documented in demo/.env.example, not read by any gate command. (optional)
STORAGE_ADAPTER=

# production: read by demo/config/environments/production.js for S3 storage; never needed by setup/dev/check. (optional)
AWS_ACCESS_KEY_ID=

# production: read by demo/config/environments/production.js for S3 storage; never needed by setup/dev/check. (optional)
AWS_SECRET_ACCESS_KEY=

# production: read by demo/config/environments/production.js for mail delivery; never needed by setup/dev/check. (optional)
SENDGRID_API_KEY=

# Services these commands need running:
#   postgres — demo/docker-compose.yml service `postgres` (postgres:16-alpine, port 5432, db demo_development); CI runs the same image 
#   redis — demo/docker-compose.yml service `redis` (redis:7-alpine, port 6379); CI runs redis:7 as a service. Needed only for BullM
#   mailhog — demo/docker-compose.yml service `mailhog` (SMTP 1025, web UI 8025) for local mail testing.
